{
  "$schema": "https://json.schemastore.org/angular-workspace.json",
  "version": 1,
  "defaultProject": "tire-test-reporting-platform",
  "projects": {
    "tire-test-reporting-platform": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:browser",
          "options": {
            "outputPath": "dist/tire-test-reporting-platform",
            "index": "src/index.html",
            "main": "src/main.ts",
            "polyfills": ["zone.js"],
            "tsConfig": "tsconfig.app.json",
            "assets": ["src/favicon.ico", "src/assets"],
            "styles": ["src/styles.css"],
            "scripts": []
          }
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "options": {
            "browserTarget": "tire-test-reporting-platform:build"
          }
        }
      }
    }
  }
}
